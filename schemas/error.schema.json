{
  "$defs": {
    "ControlIdSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "controlId": {
          "minLength": 1,
          "title": "Controlid",
          "type": "string"
        },
        "kind": {
          "const": "controlId",
          "title": "Kind",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "controlId"
      ],
      "title": "ControlIdSelectorContract",
      "type": "object"
    },
    "LabelSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "label"
      ],
      "title": "LabelSelectorContract",
      "type": "object"
    },
    "ModelIdSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "modelId",
          "title": "Kind",
          "type": "string"
        },
        "modelId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Modelid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "modelId"
      ],
      "title": "ModelIdSelectorContract",
      "type": "object"
    },
    "PathSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "path",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "path"
      ],
      "title": "PathSelectorContract",
      "type": "object"
    },
    "PlaceholderSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "placeholder",
          "title": "Kind",
          "type": "string"
        },
        "placeholder": {
          "minLength": 1,
          "title": "Placeholder",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "placeholder"
      ],
      "title": "PlaceholderSelectorContract",
      "type": "object"
    },
    "RoleSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "role",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "role"
      ],
      "title": "RoleSelectorContract",
      "type": "object"
    },
    "TextSelectorContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "text"
      ],
      "title": "TextSelectorContract",
      "type": "object"
    }
  },
  "$id": "https://xui-lab.local/schemas/error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifacts"
    },
    "capability": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    },
    "code": {
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "details": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "operation": {
      "minLength": 1,
      "title": "Operation",
      "type": "string"
    },
    "requestId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requestid"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "selector": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "controlId": "#/$defs/ControlIdSelectorContract",
              "label": "#/$defs/LabelSelectorContract",
              "modelId": "#/$defs/ModelIdSelectorContract",
              "path": "#/$defs/PathSelectorContract",
              "placeholder": "#/$defs/PlaceholderSelectorContract",
              "role": "#/$defs/RoleSelectorContract",
              "text": "#/$defs/TextSelectorContract"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PathSelectorContract"
            },
            {
              "$ref": "#/$defs/ModelIdSelectorContract"
            },
            {
              "$ref": "#/$defs/ControlIdSelectorContract"
            },
            {
              "$ref": "#/$defs/RoleSelectorContract"
            },
            {
              "$ref": "#/$defs/LabelSelectorContract"
            },
            {
              "$ref": "#/$defs/PlaceholderSelectorContract"
            },
            {
              "$ref": "#/$defs/TextSelectorContract"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selector"
    },
    "treeExcerpt": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Treeexcerpt"
    },
    "type": {
      "const": "error",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "code",
    "message",
    "operation",
    "retryable"
  ],
  "title": "xui-lab error record",
  "type": "object"
}
