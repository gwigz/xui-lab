  "info": {
    "title": "XUI Lab Inspector",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/actions": {
      "post": {
        "operationId": "post_actions_api_v1_actions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InteractiveAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorActionAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorActionRejected"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorActionRejected"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorActionRejected"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Post Actions"
      }
    },
    "/api/v1/captures/{version}": {
      "get": {
        "operationId": "get_capture_api_v1_captures__version__get",
        "parameters": [
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "title": "Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/png": {}
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorErrorBody"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Capture"
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "get_events_api_v1_events_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "captureVersion": {
                      "anyOf": [
                        {
                          "minimum": 0.0,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Captureversion"
                    },
                    "eventId": {
                      "minimum": 0.0,
                      "title": "Eventid",
                      "type": "integer"
                    },
                    "requestId": {
                      "anyOf": [
                        {
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Requestid"
                    },
                    "stateVersion": {
                      "minimum": 0.0,
                      "title": "Stateversion",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "eventId",
                    "stateVersion"
                  ],
                  "title": "InspectorSessionEvent",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Events"
      }
    },
    "/api/v1/state": {
      "get": {
        "operationId": "get_state_api_v1_state_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorStateDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorErrorBody"
                }
              }
            },
            "description": "Request Entity Too Large"
          }
        },
        "summary": "Get State"
      }
    }
  }
}
