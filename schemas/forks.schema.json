{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xui-lab.local/schemas/forks.schema.json",
  "title": "xui-lab viewer fork manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultFork", "forks"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultFork": {
      "$ref": "#/$defs/id"
    },
    "forks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fork"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "source",
        "adapter",
        "buildDriver",
        "resourceRoot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "submodule"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "adapter": {
          "$ref": "#/$defs/relativePath"
        },
        "buildDriver": {
          "type": "string",
          "minLength": 1
        },
        "resourceRoot": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
