{
  "$defs": {
    "ForkContract": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "resourceRoot": {
          "minLength": 1,
          "title": "Resourceroot",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ForkSourceContract"
        }
      },
      "required": [
        "id",
        "displayName",
        "source",
        "adapter",
        "resourceRoot"
      ],
      "title": "ForkContract",
      "type": "object"
    },
    "ForkSourceContract": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "const": "submodule",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "title": "ForkSourceContract",
      "type": "object"
    }
  },
  "$id": "https://xui-lab.local/schemas/forks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "defaultFork": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Defaultfork",
      "type": "string"
    },
    "forks": {
      "items": {
        "$ref": "#/$defs/ForkContract"
      },
      "minItems": 1,
      "title": "Forks",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "defaultFork",
    "forks"
  ],
  "title": "xui-lab viewer fork manifest",
  "type": "object"
}
