{
  "$defs": {
    "AgentFixtureContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AgentFixtureContract",
      "type": "object"
    },
    "AvatarNameFixtureContract": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "userName": {
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName",
        "userName"
      ],
      "title": "AvatarNameFixtureContract",
      "type": "object"
    },
    "InventoryFolderEntryContract": {
      "additionalProperties": false,
      "properties": {
        "favorite": {
          "default": false,
          "title": "Favorite",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "folder",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parentId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Parentid",
          "type": "string"
        },
        "thumbnailId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnailid"
        }
      },
      "required": [
        "id",
        "parentId",
        "name",
        "kind"
      ],
      "title": "InventoryFolderEntryContract",
      "type": "object"
    },
    "InventoryItemEntryContract": {
      "additionalProperties": false,
      "properties": {
        "favorite": {
          "default": false,
          "title": "Favorite",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "animation",
            "gesture",
            "landmark",
            "material",
            "notecard",
            "script",
            "sound",
            "texture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parentId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Parentid",
          "type": "string"
        },
        "thumbnailId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnailid"
        }
      },
      "required": [
        "id",
        "parentId",
        "name",
        "kind"
      ],
      "title": "InventoryItemEntryContract",
      "type": "object"
    },
    "InventoryRootEntryContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "root",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parentId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Parentid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parentId",
        "name",
        "kind"
      ],
      "title": "InventoryRootEntryContract",
      "type": "object"
    },
    "InventoryWornItemEntryContract": {
      "additionalProperties": false,
      "properties": {
        "favorite": {
          "default": false,
          "title": "Favorite",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "object",
            "wearable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parentId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Parentid",
          "type": "string"
        },
        "thumbnailId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnailid"
        },
        "worn": {
          "default": false,
          "title": "Worn",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "parentId",
        "name",
        "kind"
      ],
      "title": "InventoryWornItemEntryContract",
      "type": "object"
    }
  },
  "$id": "https://xui-lab.local/schemas/fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "agent": {
      "$ref": "#/$defs/AgentFixtureContract"
    },
    "avatarNames": {
      "items": {
        "$ref": "#/$defs/AvatarNameFixtureContract"
      },
      "title": "Avatarnames",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "inventory": {
      "items": {
        "discriminator": {
          "mapping": {
            "animation": "#/$defs/InventoryItemEntryContract",
            "folder": "#/$defs/InventoryFolderEntryContract",
            "gesture": "#/$defs/InventoryItemEntryContract",
            "landmark": "#/$defs/InventoryItemEntryContract",
            "material": "#/$defs/InventoryItemEntryContract",
            "notecard": "#/$defs/InventoryItemEntryContract",
            "object": "#/$defs/InventoryWornItemEntryContract",
            "root": "#/$defs/InventoryRootEntryContract",
            "script": "#/$defs/InventoryItemEntryContract",
            "sound": "#/$defs/InventoryItemEntryContract",
            "texture": "#/$defs/InventoryItemEntryContract",
            "wearable": "#/$defs/InventoryWornItemEntryContract"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/InventoryRootEntryContract"
          },
          {
            "$ref": "#/$defs/InventoryFolderEntryContract"
          },
          {
            "$ref": "#/$defs/InventoryItemEntryContract"
          },
          {
            "$ref": "#/$defs/InventoryWornItemEntryContract"
          }
        ]
      },
      "minItems": 1,
      "title": "Inventory",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "agent",
    "inventory",
    "avatarNames"
  ],
  "title": "xui-lab deterministic viewer fixture",
  "type": "object"
}
