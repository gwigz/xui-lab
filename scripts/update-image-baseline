#!/usr/bin/env python3
"""Copy a scenario capture into its platform-specific baseline directory."""

from __future__ import annotations

import argparse
import platform
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("capture", type=Path)
    parser.add_argument("name")
    parser.add_argument("--platform", default=platform.system().lower())
    args = parser.parse_args()

    capture = args.capture.expanduser().resolve()
    if not capture.is_file() or capture.suffix.lower() != ".png":
        parser.error(f"capture is not a PNG file: {capture}")
    if not args.name or Path(args.name).name != args.name:
        parser.error("name must be one file name")
    if not args.platform or Path(args.platform).name != args.platform:
        parser.error("platform must be one directory name")

    destination = ROOT / "tests" / "baselines" / args.platform / args.name
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(capture, destination)
    print(destination.relative_to(ROOT))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
