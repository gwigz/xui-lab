{
  "$schema": "../schemas/scenario.schema.json",
  "schemaVersion": 1,
  "id": "test_floater",
  "fork": "alchemy",
  "subject": "test_widgets",
  "viewport": { "width": 1024, "height": 700, "uiScale": 1.0 },
  "requires": ["input", "inspection"],
  "steps": [
    { "op": "frames", "count": 2 },
    { "op": "stable", "consecutiveFrames": 2, "maximumFrames": 60, "saveAs": "stable" },
    { "op": "assert", "source": "stable", "pointer": "/stable", "comparison": "equals", "expected": true },
    { "op": "resize", "width": 1024, "height": 700, "uiScale": 1.0, "saveAs": "viewport" },
    { "op": "assert", "source": "viewport", "pointer": "/lluiWidth", "comparison": "equals", "expected": 1024 },
    { "op": "reload", "saveAs": "reload" },
    { "op": "assert", "source": "reload", "pointer": "/subject", "comparison": "equals", "expected": "test_widgets" },
    { "op": "query", "kind": "tree", "saveAs": "tree" },
    { "op": "assert", "source": "tree", "pointer": "/path", "comparison": "exists" },
    { "op": "query", "kind": "tree", "path": "/Floater View/floater_test_widgets/test_checkbox", "saveAs": "checkboxBefore" },
    { "op": "assert", "source": "checkboxBefore", "pointer": "/value", "comparison": "equals", "expected": false },
    { "op": "input", "event": "click", "button": "left", "path": "/Floater View/floater_test_widgets/test_checkbox/CheckboxCtrl Button", "saveAs": "click" },
    { "op": "assert", "source": "click", "pointer": "/handled", "comparison": "equals", "expected": true },
    { "op": "query", "kind": "tree", "path": "/Floater View/floater_test_widgets/test_checkbox", "saveAs": "checkboxAfter" },
    { "op": "assert", "source": "checkboxAfter", "pointer": "/value", "comparison": "equals", "expected": true },
    { "op": "query", "kind": "value", "path": "/Floater View/floater_test_widgets/test_checkbox", "saveAs": "checkboxUiValue" },
    { "op": "assert", "source": "checkboxUiValue", "pointer": "/value", "comparison": "equals", "expected": true },
    { "op": "diagnostics", "saveAs": "diagnostics" },
    { "op": "assert", "source": "diagnostics", "pointer": "/subject/id", "comparison": "equals", "expected": "test_widgets" },
    { "op": "assert", "source": "diagnostics", "pointer": "/subject/view/path", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/focus", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/mouseCapture", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/visibleMenu", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/viewport/pixelWidth", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/viewport/windowMeasured", "comparison": "equals", "expected": true },
    { "op": "assert", "source": "diagnostics", "pointer": "/viewport/lluiWidth", "comparison": "equals", "expected": 1024 },
    { "op": "assert", "source": "diagnostics", "pointer": "/graphics/gl_renderer", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/eventApis/UI", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/eventApis/LLFloaterReg", "comparison": "exists" },
    { "op": "assert", "source": "diagnostics", "pointer": "/eventApis/LLWindow", "comparison": "exists" },
    { "op": "capture", "name": "test-floater", "includeOverlay": true, "highlight": { "path": "/Floater View/floater_test_widgets/test_checkbox" } }
  ]
}
